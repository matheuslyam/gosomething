#!/bin/sh
# Harness layer 1 (see ADR-0012): every commit message must carry an explicit
# QA trailer (e.g. "QA: GO round 1/5"). The trailer is audit metadata, not
# proof — proof is the green gate + CI. Missing trailer = reject.
if ! grep -qiE 'QA:.*GO' "$1"; then
  echo "BLOCKED: commit message needs a QA trailer matching /QA:.*GO/ (case-insensitive)."
  echo "Example body line: QA: GO (self+external), rounds 1/5"
  exit 1
fi
exit 0
